{
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Display name shown on the map marker"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude of the user"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude of the user"
    },
    "location_label": {
      "type": "string",
      "description": "Human-readable location"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83e\uddcd",
      "description": "Emoji avatar shown on the map for this user"
    },
    "avatar_url": {
      "type": "string",
      "description": "Optional photo avatar shown on the map instead of emoji"
    },
    "sharing_visibility": {
      "type": "string",
      "enum": [
        "community",
        "trusted_contacts",
        "emergency_only"
      ],
      "default": "community",
      "description": "Privacy scope for location sharing"
    },
    "sharing_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "stopped"
      ],
      "default": "active",
      "description": "Sharing state: active, paused, or stopped"
    },
    "last_active_at": {
      "type": "string",
      "description": "ISO timestamp of last known location update"
    }
  },
  "required": [
    "location_lat",
    "location_lng"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "UserLocation",
  "type": "object"
}